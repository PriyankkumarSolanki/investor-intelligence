# Copy to .env and fill in. Never commit .env.

# --- Google Gemini (free tier) ---
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- Embeddings ---
# local (default, fastembed bge-small, 384-dim, no API quota) or
# gemini (API embeddings, 100 req/min + low daily cap; small docs only, 768-dim).
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=384

# --- Postgres (Docker Compose defaults; override for external DB) ---
POSTGRES_DB=investor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# For running the API on the host (not compose), set POSTGRES_HOST=localhost.
POSTGRES_HOST=db
POSTGRES_PORT=5432
